# Generate both secrets locally. APP_PASSWORD should be at least 12 characters;
# SESSION_SECRET should be a random string with at least 32 bytes.
APP_PASSWORD=change-this-to-a-long-unique-password
SESSION_SECRET=replace-with-at-least-32-random-bytes
COOKIE_SECURE=false
APP_BIND=127.0.0.1:3000
DATABASE_PATH=data/whatsapp.sqlite

# Meta WhatsApp Cloud API credentials. Keep real values out of source control.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
GRAPH_API_VERSION=v23.0
